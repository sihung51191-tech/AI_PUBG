<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals" Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>True</Microsoft_AI_DirectML_SkipDebugLayerCopy>
    <Microsoft_AI_DirectML_SkipLibraryCopy>False</Microsoft_AI_DirectML_SkipLibraryCopy>
  </PropertyGroup>

  <PropertyGroup Label="Globals" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>True</Microsoft_AI_DirectML_SkipDebugLayerCopy>
    <Microsoft_AI_DirectML_SkipLibraryCopy>False</Microsoft_AI_DirectML_SkipLibraryCopy>
  </PropertyGroup>

  <PropertyGroup Label="Globals" Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>True</Microsoft_AI_DirectML_SkipDebugLayerCopy>
    <Microsoft_AI_DirectML_SkipLibraryCopy>False</Microsoft_AI_DirectML_SkipLibraryCopy>
  </PropertyGroup>

  <PropertyGroup Label="Globals" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>True</Microsoft_AI_DirectML_SkipDebugLayerCopy>
    <Microsoft_AI_DirectML_SkipLibraryCopy>False</Microsoft_AI_DirectML_SkipLibraryCopy>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <OutputPath>$(MSBuildProjectDirectory)\bin\Build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>	  <Product>AIOK</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>icon\target.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Title>AIOK</Title>
    <AssemblyName>CouldBeAimmyV2</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>False</SignAssembly>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
  
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>False</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="scratch\**\*.cs;tests\**\*.cs" />
    <Page Remove="tests\**\*.xaml" />
    <None Include="..\.editorconfig" Link=".editorconfig" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="JYPPX.TensorRT.CSharp.API" Version="0.0.5.2" />
    <PackageReference Include="JYPPX.TensorRT.CSharp.API.runtime.win-x64.cuda12" Version="0.0.5" />
    <PackageReference Include="MouseKeyHook" Version="5.7.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20240616" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20240616" />
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="XamlRadialProgressBar" Version="1.0.3" />
  </ItemGroup>

	<ItemGroup>
		<Resource Include="Graphics\Fonts\akony.otf" />
		<Resource Include="Graphics\Fonts\AtkinsonHyperlegible-Bold.ttf" />
		<Resource Include="Graphics\Fonts\AtkinsonHyperlegible-BoldItalic.ttf" />
		<Resource Include="Graphics\Fonts\AtkinsonHyperlegible-Italic.ttf" />
		<Resource Include="Graphics\Fonts\AtkinsonHyperlegible-Regular.ttf" />
		<Resource Include="Graphics\Fonts\Font Awesome 6 Free-Regular-400.otf" />
		<Resource Include="Graphics\Fonts\Font Awesome 6 Free-Solid-900.otf" />
		<Resource Include="Graphics\Fonts\Font Awesome 6 Brands-Regular-400.otf" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Other\ThemeManager.cs">
	    <Generator>MSBuild:Compile</Generator>
	  </Compile>
	  <Compile Update="Properties\Settings.Designer.cs">
	    <DesignTimeSharedInput>True</DesignTimeSharedInput>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Settings.settings</DependentUpon>
	  </Compile>
	  <Compile Update="Other\StreamGuardManager.cs">
	    <Generator>MSBuild:Compile</Generator>
	  </Compile>
	  <Compile Update="UILibrary\AFileLocator.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="UILibrary\ASpacer.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="UILibrary\ASlider.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="UILibrary\AColorChanger.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="UILibrary\AKeyChanger.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="UILibrary\ARectangleBottom.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="UILibrary\APButton.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	  <Compile Update="MouseMovementLibraries\GHubSupport\LGDownloader.xaml.cs">
	    <SubType>Code</SubType>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <None Update="Properties\Settings.settings">
	    <Generator>SettingsSingleFileGenerator</Generator>
	    <LastGenOutput>Settings.Designer.cs</LastGenOutput>
	  </None>
      <Content Include="icon\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <Content Include="loot\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
	</ItemGroup>

  <Target Name="CreateScopeModelsFolder" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir)bin\scope_models" Condition="!Exists('$(TargetDir)bin\scope_models')" />
    <MakeDir Directories="$(TargetDir)bin\weapon_models" Condition="!Exists('$(TargetDir)bin\weapon_models')" />
    <MakeDir Directories="$(TargetDir)bin\templates\weapons" Condition="!Exists('$(TargetDir)bin\templates\weapons')" />
    <MakeDir Directories="$(TargetDir)bin\templates\scopes" Condition="!Exists('$(TargetDir)bin\templates\scopes')" />
    <MakeDir Directories="$(TargetDir)bin\configs" Condition="!Exists('$(TargetDir)bin\configs')" />
  </Target>

</Project>
