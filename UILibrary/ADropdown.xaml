<UserControl x:Class="UILibrary.ADropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:UILibrary"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             Height="86">
    <Grid>
        <Border Height="80"
                Margin="6,3"
                Background="{DynamicResource ThemeSurface}"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeOutline}">
            <Grid>
                <Label x:Name="DropdownTitle"
                       Padding="10,10,10,10"
                       FontFamily="{StaticResource Atkinson Hyperlegible}"
                       Content="Prediction Method"
                       Foreground="{DynamicResource ThemeTextPrimary}"
                       VerticalContentAlignment="Center"
                       FontSize="13"
                       VerticalAlignment="Top"
                       Height="40" />
                <ComboBox x:Name="DropdownBox"
                          Height="30"
                          Margin="10,0,10,10"
                          VerticalAlignment="Bottom"
                          Foreground="{DynamicResource ThemeTextPrimary}"
                          BorderBrush="{DynamicResource ThemeOutline}"
                          Padding="5,0,5,0"
                          BorderThickness="1,1,1,1"
                          Background="{DynamicResource ThemeSurfaceRaised}"
                          SelectedIndex="0"
                          FontFamily="{StaticResource Atkinson Hyperlegible}"
                          SelectionChanged="DropdownBox_SelectionChanged">
                </ComboBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
