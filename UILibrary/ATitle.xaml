<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Aimmy2.UILibrary"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:theme="clr-namespace:Aimmy2.Theme"
             x:Class="Aimmy2.UILibrary.ATitle"
             theme:ThemeBehavior.AutoRegister="True"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             d:DesignHeight="40">
    <Grid>
        <Border Height="40"
                Margin="1"
                Background="{DynamicResource ThemeSurfaceRaised}"
                CornerRadius="7"
                BorderThickness="0"
                BorderBrush="Transparent">
            <Grid>
                <Label x:Name="LabelTitle"
                       Padding="10,10,10,10"
                       FontFamily="{StaticResource Atkinson Hyperlegible}"
                       Content="Title"
                       Foreground="{DynamicResource ThemeTextPrimary}"
                       VerticalContentAlignment="Center"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,0,30,0" />
                <Button x:Name="Minimize"
                        Style="{StaticResource CompactIconButton}"
                        Content="&#xE921;"
                        HorizontalAlignment="Right"
                        BorderThickness="0"
                        Foreground="{DynamicResource ThemeTextPrimary}"
                        Background="Transparent"
                        FontFamily="Segoe MDL2 Assets"
                        Padding="10,10,10,10"
                        FontSize="10"
                        Visibility="Collapsed" Margin="0,4,3,3" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
