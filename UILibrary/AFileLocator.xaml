<UserControl x:Class="UILibrary.AFileLocator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:UILibrary"
             xmlns:theme="clr-namespace:Aimmy2.Theme"
             theme:ThemeBehavior.AutoRegister="True"
             mc:Ignorable="d"
             d:DesignWidth="282.5"
             Height="86">

    <Grid>
        <Border Height="80"
                Margin="6,3"
                Background="{DynamicResource ThemeSurface}"
                BorderThickness="1"
                BorderBrush="{DynamicResource ThemeOutline}"
                CornerRadius="8">

            <Grid>
                <Label x:Name="DropdownTitle"
                       Padding="10,10,10,10"
                       FontFamily="{StaticResource Atkinson Hyperlegible}"
                       Content="Prediction Method"
                       Foreground="{DynamicResource ThemeTextPrimary}"
                       VerticalContentAlignment="Center"
                       FontSize="13"
                       VerticalAlignment="Top"
                       Height="40" />

                <TextBox x:Name="FileLocationTextbox"
                         BorderBrush="{DynamicResource ThemeOutline}"
                         Foreground="White"
                         BorderThickness="1"
                         TextWrapping="Wrap"
                         Text=""
                         Tag="No File Located"
                         VerticalAlignment="Top"
                         FontFamily="{StaticResource Atkinson Hyperlegible}"
                         Padding="5,0,5,0"
                         Style="{DynamicResource placeHolder}"
                         Background="{x:Null}"
                         Margin="10,40,45,0"
                         Height="30"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center" />

                <Button x:Name="OpenFileB"
                            Style="{StaticResource CompactIconButton}"
                            Background="{DynamicResource ThemeSecondaryAction}"
                            Content="&#xE838;"
                            HorizontalAlignment="Right"
                            Height="30"
                            Width="30"
                            Margin="0,0,10,10"
                            VerticalAlignment="Bottom"
                            Padding="0,0,0,0"
                            FontFamily="Segoe MDL2 Assets"
                            BorderThickness="0,0,0,0"
                            FontSize="13"
                            Foreground="{DynamicResource ThemeSecondaryActionForeground}"
                            Click="OpenFileB_Click" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
