<UserControl x:Class="Aimmy2.Controls.ModelMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Aimmy2.Controls"
             mc:Ignorable="d">
    <ScrollViewer x:Name="ModelMenu"
                  VerticalScrollBarVisibility="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <Grid>
            <TabControl HorizontalContentAlignment="Stretch"
                        Margin="10,0,10,0"
                        Style="{StaticResource ModelsTabControl}">
                <TabItem Header="Tổng quan" Style="{StaticResource ModelsTabItem}">
                    <controls:ModelDashboard />
                </TabItem>
                <TabItem Style="{StaticResource ModelsTabItem}">
                    <TabItem.Header>
                        <TextBlock Text="Model AI (Slot 1)"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   FontFamily="{StaticResource Atkinson Hyperlegible}" />
                    </TabItem.Header>
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Visible"
                                      PanningMode="VerticalOnly"
                                      Margin="0,10,-6,0">
                            <StackPanel>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                BorderThickness="1"
                                CornerRadius="5,5,0,0"
                                Margin="0,0,0,0"
                                Height="39">
                                    <TextBox
                                x:Name="Slot1ModelSearchBox"
                                FontFamily="{StaticResource Atkinson Hyperlegible}"
                                Padding="5"
                                Foreground="White"
                                CaretBrush="White"
                                TextChanged="Slot1ModelSearchBox_TextChanged">
                                    </TextBox>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                BorderThickness="1"
                                Margin="0,55,0,54">
                            <ListBox x:Name="Slot1ModelListBox"
                                     AllowDrop="True"
                                     Drop="ModelListBox_Drop"
                                     DragOver="ModelListBox_DragOver"
                                     Foreground="{DynamicResource ThemeTextPrimary}"
                                     FontFamily="{StaticResource Atkinson Hyperlegible}"
                                     Margin="0"
                                     Padding="2">
                            </ListBox>
                        </Border>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                BorderThickness="1"
                                CornerRadius="0,0,0,5"
                                Margin="0,0,44,10"
                                VerticalAlignment="Bottom"
                                Height="39">
                            <Label x:Name="Slot1Notifier"
                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                   Content="Đã tải Slot 1: N/A"
                                   FontFamily="{StaticResource Atkinson Hyperlegible}"
                                   Padding="10"></Label>
                        </Border>
                        <Button Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                Content="&#xE838;"
                                HorizontalAlignment="Right"
                                Height="39"
                                Width="39"
                                Margin="0,0,0,10"
                                VerticalAlignment="Bottom"
                                Padding="0,0,0,0"
                                FontFamily="Segoe MDL2 Assets"
                                BorderThickness="1"
                                materialDesign:ButtonAssist.CornerRadius="0,0,5,0"
                                FontSize="13"
                                Foreground="{DynamicResource ThemeTextPrimary}"
                                Click="OpenFolderB_Click"
                                Tag="models" />
                    </Grid>
                </TabItem>
                <TabItem Style="{StaticResource ModelsTabItem}">
                    <TabItem.Header>
                        <TextBlock Text="Model AI (Slot 2)"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   FontFamily="{StaticResource Atkinson Hyperlegible}" />
                    </TabItem.Header>
                    <Grid>
                        <ScrollViewer x:Name="LocalModelStoreMenu"
                                      VerticalScrollBarVisibility="Visible"
                                      PanningMode="VerticalOnly"
                                      Margin="0,10,-6,0">
                            <StackPanel>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                BorderThickness="1"
                                CornerRadius="5,5,0,0"
                                Margin="0,0,0,0"
                                Height="39">
                                    <TextBox
                                x:Name="LocalModelSearchBox"
                                FontFamily="{StaticResource Atkinson Hyperlegible}"
                                Padding="5"
                                Foreground="White"
                                CaretBrush="White"
                                TextChanged="LocalModelSearchBox_TextChanged">
                                    </TextBox>
                                </Border>
                                <StackPanel x:Name="LocalModelStoreScroller" />
                            </StackPanel>
                        </ScrollViewer>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                BorderThickness="1"
                                Margin="0,55,0,54">
                            <ListBox x:Name="ModelListBox"
                                     AllowDrop="True"
                                     Drop="ModelListBox_Drop"
                                     DragOver="ModelListBox_DragOver"
                                     Foreground="{DynamicResource ThemeTextPrimary}"
                                     FontFamily="{StaticResource Atkinson Hyperlegible}"
                                     Margin="0"
                                     Padding="2">
                            </ListBox>
                        </Border>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                BorderThickness="1"
                                CornerRadius="0,0,0,5"
                                Margin="0,0,44,10"
                                VerticalAlignment="Bottom"
                                Height="39">
                            <Label x:Name="SelectedModelNotifier"
                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                   Content="Đã tải Slot 2: N/A"
                                   FontFamily="{StaticResource Atkinson Hyperlegible}"
                                   Padding="10"></Label>
                        </Border>
                        <Button x:Name="OpenFolderB_ModelWindow"
                                Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                Content="&#xE838;"
                                HorizontalAlignment="Right"
                                Height="39"
                                Width="39"
                                Margin="0,0,0,10"
                                VerticalAlignment="Bottom"
                                Padding="0,0,0,0"
                                FontFamily="Segoe MDL2 Assets"
                                BorderThickness="1"
                                materialDesign:ButtonAssist.CornerRadius="0,0,5,0"
                                FontSize="13"
                                Foreground="{DynamicResource ThemeTextPrimary}"
                                Click="OpenFolderB_Click"
                                Tag="models" />
                    </Grid>
                </TabItem>
                <TabItem Style="{StaticResource ModelsTabItem}">
                    <TabItem.Header>
                        <TextBlock Text="Configs Cục Bộ"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   FontFamily="{StaticResource Atkinson Hyperlegible}" />
                    </TabItem.Header>
                    <Grid>
                        <ScrollViewer x:Name="LocalConfigStoreMenu"
                              VerticalScrollBarVisibility="Visible"
                              PanningMode="VerticalOnly"
                              Margin="0,10,-6,0">
                            <StackPanel>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                    BorderThickness="1"
                                    CornerRadius="5,5,0,0"
                                    Margin="0,0,0,0"
                                    Height="39">
                                    <TextBox
                                        x:Name="LocalConfigSearchBox"
                                        FontFamily="{StaticResource Atkinson Hyperlegible}"
                                        Padding="5"
                                        Foreground="White"
                                        CaretBrush="White"
                                        TextChanged="LocalConfigSearchBox_TextChanged">
                                    </TextBox>
                                </Border>
                                <StackPanel x:Name="LocalConfigStoreScroller" />
                            </StackPanel>
                        </ScrollViewer>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                BorderThickness="1"
                                Margin="0,55,0,54">
                            <ListBox x:Name="ConfigsListBox"
                                     AllowDrop="True"
                                     Drop="ConfigsListBox_Drop"
                                     DragOver="ConfigsListBox_DragOver"
                                     Foreground="{DynamicResource ThemeTextPrimary}"
                                     FontFamily="{StaticResource Atkinson Hyperlegible}"
                                     Margin="0"
                                     Padding="2" />
                        </Border>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                BorderThickness="1"
                                CornerRadius="0,0,0,5"
                                Margin="0,0,44,10"
                                VerticalAlignment="Bottom"
                                Height="39">
                            <Label x:Name="SelectedConfigNotifier"
                                   Foreground="{DynamicResource ThemeTextSecondary}"
                                   Content="Đã tải Config: N/A"
                                   FontFamily="{StaticResource Atkinson Hyperlegible}"
                                   Padding="10"></Label>
                        </Border>
                        <Button x:Name="OpenFolderB_ConfigWindow"
                                Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                Content="&#xE838;"
                                HorizontalAlignment="Right"
                                Height="39"
                                Width="39"
                                Margin="0,0,0,10"
                                VerticalAlignment="Bottom"
                                Padding="0,0,0,0"
                                FontFamily="Segoe MDL2 Assets"
                                BorderThickness="1"
                                materialDesign:ButtonAssist.CornerRadius="0,0,5,0"
                                FontSize="13"
                                Foreground="{DynamicResource ThemeTextPrimary}"
                                Click="OpenFolderB_Click"
                                Tag="configs" />
                    </Grid>
                </TabItem>
                <TabItem Style="{StaticResource ModelsTabItem}">
                    <TabItem.Header>
                        <TextBlock Text="Tải Models"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   FontFamily="{StaticResource Atkinson Hyperlegible}" />
                    </TabItem.Header>
                    <Grid>
                        <Label x:Name="LackOfModelsText"
                               Visibility="Collapsed"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               Content="Hiện không có models nào để tải, vui lòng kiểm tra lại sau."
                               Foreground="{DynamicResource ThemeTextSecondary}" />
                        <ScrollViewer x:Name="ModelStoreMenu"
                                      VerticalScrollBarVisibility="Visible"
                                      PanningMode="VerticalOnly"
                                      Margin="0,10,0,0">
                            <StackPanel>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                        BorderThickness="1"
                                        CornerRadius="5,5,0,0"
                                        Margin="0,0,5,10"
                                        Height="39">
                                    <TextBox
                                        x:Name="SearchBox"
                                        FontFamily="{StaticResource Atkinson Hyperlegible}"
                                        Padding="5"
                                        Foreground="White"
                                        CaretBrush="White"
                                        TextChanged="SearchBox_TextChanged">
                                    </TextBox>
                                </Border>
                                <StackPanel x:Name="ModelStoreScroller" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Style="{StaticResource ModelsTabItem}">
                    <TabItem.Header>
                        <TextBlock Text="Tải Configs"
                                   Foreground="{DynamicResource ThemeTextPrimary}"
                                   FontFamily="{StaticResource Atkinson Hyperlegible}" />
                    </TabItem.Header>
                    <Grid>
                        <Label x:Name="LackOfConfigsText"
                               Visibility="Collapsed"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"
                               Content="Hiện không có configs nào để tải, vui lòng kiểm tra lại sau."
                               Foreground="{DynamicResource ThemeTextSecondary}" />
                        <ScrollViewer x:Name="ConfigStoreMenu"
                                      VerticalScrollBarVisibility="Visible"
                                      PanningMode="VerticalOnly"
                                      Margin="0,10,0,0">
                            <StackPanel>
                                <Border Background="{DynamicResource ThemeSurface}"
                                BorderBrush="{DynamicResource ThemeOutline}"
                                        BorderThickness="1"
                                        CornerRadius="5,5,0,0"
                                        Margin="0,0,5,10"
                                        Height="39">
                                    <TextBox
                                        x:Name="CSearchBox"
                                        FontFamily="{StaticResource Atkinson Hyperlegible}"
                                        Padding="5"
                                        Foreground="White"
                                        CaretBrush="White"
                                        TextChanged="CSearchBox_TextChanged">
                                    </TextBox>
                                </Border>
                                <StackPanel x:Name="ConfigStoreScroller" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
