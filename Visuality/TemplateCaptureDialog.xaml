<Window x:Class="Visuality.TemplateCaptureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Template Capture" Width="620" Height="650" WindowStartupLocation="CenterOwner"
        MinWidth="520" MinHeight="610" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="12" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ModernComboBoxItem}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F4F7FA"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource ThemeOutline}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource ThemeSurface}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="{DynamicResource ThemeOutline}" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Chụp Template" Margin="14,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeTextPrimary}" FontWeight="SemiBold"/>
                    <Button x:Name="CloseButton" Grid.Column="1" Content="×" Width="42" Height="30" Margin="0,4,5,4" Padding="0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="50"
                            Background="Transparent" BorderBrush="{DynamicResource ThemeOutline}" BorderThickness="1"
                            Foreground="{DynamicResource ThemeTextPrimary}" FontSize="20" Cursor="Hand"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="18,14,18,16">
                <Grid.RowDefinitions><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{DynamicResource ThemeSurfaceElevated}" BorderBrush="{DynamicResource ThemeOutline}" BorderThickness="1" CornerRadius="8"><Image x:Name="PreviewImage" Stretch="Uniform"/></Border>
                <TextBlock x:Name="MetadataText" Grid.Row="1" Margin="0,12,0,5" TextWrapping="Wrap" Foreground="{DynamicResource ThemeTextSecondary}"/>
                <TextBlock x:Name="QualityText" Grid.Row="2" Margin="0,5" FontWeight="Bold" TextWrapping="Wrap"/>
                <Grid Grid.Row="3" Height="36" Margin="0,6">
                    <ComboBox x:Name="ExistingLabels" IsEditable="True" StaysOpenOnEdit="True" SelectionChanged="ExistingLabels_SelectionChanged" ToolTip="Bấm để xem tất cả hoặc gõ để tìm nhãn có sẵn"/>
                    <TextBlock x:Name="ExistingLabelsPlaceholder" Text="Tìm hoặc chọn tên đã có…" Margin="11,0,40,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ExistingLabels}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=ExistingLabels}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Grid.Row="4" Height="38" Margin="0,6">
                    <TextBox x:Name="NewLabel" Padding="10,0" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalContentAlignment="Center" ToolTip="Chọn nhãn có sẵn hoặc nhập nhãn mới"/>
                    <TextBlock x:Name="NewLabelPlaceholder" Text="Nhập tên template…" Margin="11,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeTextSecondary}" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NewLabel}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=NewLabel}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Row="5" Margin="2,8,0,2"><CheckBox x:Name="RememberLabel" Content="Ghi nhớ tên cho lần chụp tiếp theo" Margin="0,4"/><CheckBox x:Name="ConfirmSave" Content="Xác nhận trước khi lưu" IsChecked="True" Margin="0,4"/></StackPanel>
                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,14,0,0">
                    <Button x:Name="SaveButton" Content="Lưu" Width="100" Height="36" Margin="5" Click="Save_Click" Background="{DynamicResource ThemePrimaryAction}" Foreground="{DynamicResource ThemePrimaryActionForeground}"/><Button Content="Chụp lại" Width="100" Height="36" Margin="5" Click="Retake_Click" Background="{DynamicResource ThemeSecondaryAction}" Foreground="{DynamicResource ThemeSecondaryActionForeground}"/><Button Content="Hủy" Width="100" Height="36" Margin="5" Click="Cancel_Click" Background="{DynamicResource ThemeDangerAction}" Foreground="{DynamicResource ThemeDangerActionForeground}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
