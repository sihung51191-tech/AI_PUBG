<Window x:Class="Visuality.DetectedPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Visuality"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Normal"
        Topmost="True"
        Focusable="False"
        ShowInTaskbar="False" ShowActivated="False"
        Closing="Window_Closing"
        ResizeMode="NoResize"
        IsTabStop="False">
    <Grid>
        <!-- Canvas for drawing multiple detection boxes -->
        <Canvas x:Name="DetectionCanvas" />
        
        <Label x:Name="DetectedPlayerConfidence"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               FontFamily="Consolas"
               Content="Confidence = 20%"
               Padding="0,0,0,0"
               Opacity="0"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"
               Foreground="#DDFF0000"
               FontSize="20" />
        <Border x:Name="DetectedPlayerFocus"
                Width="50"
                Height="50"
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Visibility="Visible"
                Opacity="0" />
        <Line x:Name="DetectedTracers"
              X1="0"
              Y1="0"
              X2="10"
              Y2="10"
              Stroke="Red"
              Opacity="0">
        </Line>
        <Border x:Name="PerformanceBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" IsHitTestVisible="False">
            <UniformGrid Columns="3">
                <Border Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="{DynamicResource ThemeOutline}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><StackPanel><TextBlock Text="CHỤP MÀN HÌNH" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9"/><TextBlock x:Name="CapturePerformance" Text="—" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="17" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="{DynamicResource ThemeOutline}" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,6,0"><StackPanel><TextBlock Text="SUY LUẬN" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9"/><TextBlock x:Name="InferencePerformance" Text="—" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="17" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="{DynamicResource ThemeOutline}" BorderThickness="1" CornerRadius="8" Padding="10,7"><StackPanel><TextBlock Text="FPS SUY LUẬN" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9"/><TextBlock x:Name="FpsPerformance" Text="0" Foreground="{DynamicResource ThemeTextPrimary}" FontSize="17" Margin="0,4,0,0"/></StackPanel></Border>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
