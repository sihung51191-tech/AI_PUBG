<Window x:Class="Aimmy2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Aimmy2.Controls"
        xmlns:theme="clr-namespace:Aimmy2.Theme"
        theme:ThemeBehavior.AutoRegister="True"
        mc:Ignorable="d"
        Title="Aimmy"
        Height="600"
        MinHeight="444"
        Width="670"
        MinWidth="670"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        AllowsTransparency="True"
        Background="Transparent"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- A local template keeps the sidebar independent from third-party
             Foreground animations, which can target a frozen shared brush. -->
        <Style x:Key="SidebarMenuButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ThemeColorTransparent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ThemeColorSemiTransparent}"/>
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome ResizeBorderThickness="8"
                      CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Border x:Name="MainBorder"
                CornerRadius="12"
                BorderBrush="{DynamicResource ThemeOutline}"
                BorderThickness="1,1,1,1"
                ClipToBounds="True"
                MouseMove="Main_Background_Gradient">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1"
                                     StartPoint="0,0">
                    <LinearGradientBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform CenterY="0.5"
                                            CenterX="0.5" />
                            <SkewTransform CenterX="0.5"
                                           CenterY="0.5" />
                            <RotateTransform x:Name="RotaryGradient"
                                             Angle="0"
                                             CenterX="0.5"
                                             CenterY="0.5" />
                            <TranslateTransform />
                        </TransformGroup>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="Black"
                                  Offset="0.27" />
                    <GradientStop x:Name="GradientThemeStop" 
                                  Color="#FF120338"
                                  Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid x:Name="Topbar"
                      VerticalAlignment="Top"
                      Height="38"
                      MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Path x:Name="AimmyLogo"
                          Fill="White"
                          StrokeThickness="1.33333"
                          Stretch="Fill"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Width="20"
                          Height="10"
                          Margin="15,0,0,0">
                        <Path.Data>
                            <PathGeometry Figures="M 18.2472,490.72756 0.18686636,472.66723 153.0173,318.84293 305.84774,165.01862 l 17.74245,17.70593 17.74244,17.70592 17.0189,-16.98112 c 9.36039,-9.33961 17.60957,-16.98112 18.33151,-16.98112 0.72194,0 69.86022,68.54563 153.64061,152.32363 l 152.32798,152.32362 -18.32581,18.45368 -18.3258,18.45368 -152.3021,-153.11064 -152.3021,-153.11063 -20.36457,20.6423 C 309.83073,233.79713 241.18587,302.86906 168.4871,375.93703 L 36.307534,508.7879 Z"
                                          FillRule="NonZero" />
                        </Path.Data>
                    </Path>
                    <Label Content="Aimmy"
                           HorizontalAlignment="Left"
                           Margin="45,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#DDFFFFFF"
                           Padding="0,0,0,0"
                           FontSize="14"
                           FontFamily="{StaticResource Atkinson Hyperlegible}" />
                    <Button x:Name="Exit"
                            Content="&#xE8BB;"
                            HorizontalAlignment="Right"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Foreground="White"
                            FontFamily="Segoe MDL2 Assets"
                            Padding="15,0,15,0"
                            materialDesign:ButtonAssist.CornerRadius="0,5,5,0"
                            BorderThickness="0,0,0,0"
                            FontSize="10"
                            VerticalAlignment="Center"
                            Panel.ZIndex="50"
                            Click="Exit_Click" />
                    <Button x:Name="Minimize"
                            Content="&#xE921;"
                            HorizontalAlignment="Right"
                            Background="{x:Null}"
                            BorderBrush="{x:Null}"
                            Foreground="White"
                            FontFamily="Segoe MDL2 Assets"
                            Padding="15,0,15,0"
                            materialDesign:ButtonAssist.CornerRadius="5,0,0,5"
                            BorderThickness="0,0,0,0"
                            FontSize="10"
                            VerticalAlignment="Center"
                            Click="Minimize_Click"
                            Margin="0,0,40,0" />
                </Grid>
                <Grid x:Name="Sidebar"
                      HorizontalAlignment="Left"
                      Width="50"
                      Margin="0,38,0,0">
                    <!-- Improved Menu Highlighter with smoother gradient -->
                    <Border x:Name="MenuHighlighter"
                            Width="50"
                            Height="50"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            ClipToBounds="True">
                        <Border.Background>
                            <RadialGradientBrush>
                                <GradientStop x:Name="HighlighterGradient1" Color="#FF722ED1" Offset="0"/>
                                <GradientStop x:Name="HighlighterGradient2" Color="#33722ED1" Offset="0.3"/>
                                <GradientStop Color="Transparent" Offset="0.9"/>
                            </RadialGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="5"/>
                        </Border.Effect>
                    </Border>

                    <!-- Menu buttons use a stable local template: no frozen-brush animation on hover. -->
                    <Button x:Name="Menu1B"
                                Tag="AimMenu"
                                Style="{StaticResource SidebarMenuButton}"
                                VerticalAlignment="Top"
                                Height="50"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE1D2;"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                Width="50"
                                ToolTip="Ngắm và recoil"
                                AutomationProperties.Name="Ngắm và recoil"
                                Click="MenuSwitch" />
                    <Button x:Name="Menu2B"
                                Tag="ModelMenu"
                                Style="{StaticResource SidebarMenuButton}"
                                VerticalAlignment="Top"
                                Height="50"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE8E5;"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                Width="50"
                                Margin="0,50,0,0"
                                ToolTip="Mô hình AI"
                                AutomationProperties.Name="Mô hình AI"
                                Click="MenuSwitch" />
                    <Button x:Name="Menu3B"
                                Tag="SettingsMenu"
                                Style="{StaticResource SidebarMenuButton}"
                                VerticalAlignment="Top"
                                Height="50"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE713;"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                Width="50"
                                Margin="0,100,0,0"
                                ToolTip="Cài đặt"
                                AutomationProperties.Name="Cài đặt"
                                Click="MenuSwitch" />
                    <Button x:Name="Menu4B"
                                Tag="AboutMenu"
                                Style="{StaticResource SidebarMenuButton}"
                                VerticalAlignment="Top"
                                Height="50"
                                FontFamily="Segoe MDL2 Assets"
                                Content="&#xE77B;"
                                FontSize="20"
                                HorizontalAlignment="Center"
                                Width="50"
                                Margin="0,150,0,0"
                                ToolTip="Giới thiệu"
                                AutomationProperties.Name="Giới thiệu"
                                Click="MenuSwitch" />
                </Grid>

                <!-- Content Area for UserControls -->
                <Grid x:Name="ContentArea" Margin="50,38,0,0">
                    <!-- UserControls will be loaded here dynamically -->
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
